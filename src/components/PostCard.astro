---
import { formatDate, getPostSlug, getReadingStats, slugifyTag, type PostEntry } from '../utils/posts';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const slug = getPostSlug(post);
const { minutes } = getReadingStats(post.body);
const tags = post.data.tags.slice(0, 5);
---

<article class="card card-interactive post-card">
  <div class="post-card-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </div>

  <h3 class="post-card-title">
    <a href={`/posts/${slug}/`}>{post.data.title}</a>
  </h3>

  {post.data.description && <p class="post-card-desc">{post.data.description}</p>}

  {tags.length > 0 && (
    <div class="post-card-tags">
      {tags.map((tag) => (
        <a href={`/tags/${slugifyTag(tag)}/`} class="badge">
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  .post-card-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .post-card-title a {
    color: var(--text);
  }

  .post-card-title a:hover {
    color: var(--accent);
  }

  .post-card-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }
</style>
