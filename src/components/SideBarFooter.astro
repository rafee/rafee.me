---
import { SITE } from '../consts';
---

<div class="block sticky bottom-0 bg-base-200 justify-center px-4 py-3 mx-2 my-2 border-t border-base-300/60">
  <div class="flex items-center justify-between">
    <!-- Social links -->
    <div class="flex items-center gap-1">
      <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle btn-sm" aria-label="GitHub" title="GitHub">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href={SITE.socials.twitter} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle btn-sm" aria-label="X / Twitter" title="X / Twitter">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle btn-sm" aria-label="LinkedIn" title="LinkedIn">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.6a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"/></svg>
      </a>
      <a href={`mailto:${SITE.email}`} class="btn btn-ghost btn-circle btn-sm" aria-label="Email" title="Email">
        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </a>
      <a href="/rss.xml" class="btn btn-ghost btn-circle btn-sm" aria-label="RSS Feed" title="RSS">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-8.18v4.813c10.563.061 19.139 8.63 19.2 19.187h4.798c-.061-13.212-10.776-23.938-23.998-24z"/></svg>
      </a>
    </div>

    <!-- Theme Mode Pill / Toggle -->
    <div class="tooltip tooltip-left" data-tip="Switch theme (Cupcake / Dark)">
      <button class="theme-toggle-btn btn btn-ghost btn-sm gap-1.5 px-2 text-xs font-mono" aria-label="Toggle Theme">
        <span class="theme-icon-cupcake hidden text-base">🧁</span>
        <span class="theme-icon-dark hidden text-base">🌙</span>
        <span class="theme-label-text text-[11px] opacity-75">Auto</span>
      </button>
    </div>
  </div>
</div>
