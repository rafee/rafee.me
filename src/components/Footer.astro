---
import { SITE } from '../consts';
const today = new Date();
---

<footer class="w-full border-t border-base-200 mt-16 py-8 px-6 text-center text-base-content/75 bg-base-100">
  <div class="max-w-[960px] mx-auto flex flex-col items-center justify-center">
    <div class="text-xs sm:text-sm">
      &copy; {today.getFullYear()} <span class="font-semibold text-base-content">{SITE.title}</span>. Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="font-bold text-primary hover:underline">Astro</a> &amp; <a href="https://github.com/manuelernestog/astrofy" target="_blank" rel="noopener noreferrer" class="font-bold text-primary hover:underline">Astrofy</a>.
    </div>
  </div>
</footer>
