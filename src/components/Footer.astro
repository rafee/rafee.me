---
import { SITE } from '../consts';
const today = new Date();
---

<footer class="footer footer-center block mb-5 pt-10 text-base-content opacity-75 border-t border-base-200 mt-12">
  <div class="pb-2 text-xs">
    &copy; {today.getFullYear()} <span class="font-semibold">{SITE.title}</span>. Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="font-bold hover:text-primary transition-colors">Astro</a> &amp; <a href="https://github.com/manuelernestog/astrofy" target="_blank" rel="noopener noreferrer" class="font-bold hover:text-primary transition-colors">Astrofy</a>.
  </div>
  <div class="inline opacity-70 text-[11px] font-mono">
    Theme: <span class="badge badge-sm badge-outline">Cupcake</span> for light &bull; <span class="badge badge-sm badge-outline">Dark</span> for dark &bull; Synced with system
  </div>
</footer>
