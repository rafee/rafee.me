---
---

<figure class="arch-diagram" aria-label="Unhurried Cloud-Native System Architecture Diagram">
  <div class="arch-header">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="arch-kicker">System Architecture Blueprint</span>
      <span class="badge badge-primary badge-outline text-xs font-mono">10 Repositories &bull; 5 Go Services</span>
    </div>
    <span class="arch-meta">Google Cloud Platform · Cloud Run · API Gateway · Terraform IaC</span>
  </div>

  <!-- Tier 1: Client -->
  <div class="arch-tier">
    <div class="tier-label">
      <span class="tier-num">01</span>
      <span>Client Tier &bull; Intentional Interaction</span>
    </div>
    <div class="tier-grid two-col">
      <div class="arch-node node-client">
        <div class="node-title">unhurried-web</div>
        <div class="node-sub">React 18 + TypeScript SPA &bull; Vite &bull; Firebase Hosting Global CDN (<code>unhurried-careers.com</code>)</div>
      </div>
      <div class="arch-node node-client">
        <div class="node-title">unhurried-extension</div>
        <div class="node-sub">Chrome Manifest V3 Apply Assistant &bull; ATS Detection (Greenhouse, Lever, Ashby, Workday) &bull; Zero tokens, <code>window.postMessage</code> relay</div>
      </div>
    </div>
  </div>

  <!-- Connector -->
  <div class="arch-connector" aria-hidden="true">
    <svg width="24" height="28" viewBox="0 0 24 28" fill="none">
      <path d="M12 2v20m0 0-5-5m5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="connector-pill">HTTPS &bull; Firebase ID Token (Google OAuth) + App Check (reCAPTCHA Enterprise) + Restricted API Key</span>
  </div>

  <!-- Tier 2: Ingress & Gateways -->
  <div class="arch-tier">
    <div class="tier-label">
      <span class="tier-num">02</span>
      <span>Edge &amp; Ingress Tier &bull; 5 Managed API Gateways</span>
    </div>
    <div class="tier-grid five-col">
      <div class="arch-node node-gateway">
        <div class="node-badge">Gateway</div>
        <div class="node-title">job-search-gw</div>
        <div class="node-sub">300 req/min quota &bull; RS256 token verification</div>
      </div>
      <div class="arch-node node-gateway">
        <div class="node-badge">Gateway</div>
        <div class="node-title">applications-gw</div>
        <div class="node-sub">300 req/min quota &bull; Pipeline &amp; gates routing</div>
      </div>
      <div class="arch-node node-gateway">
        <div class="node-badge">Gateway</div>
        <div class="node-title">resume-gw</div>
        <div class="node-sub">300 req/min quota &bull; Resume Studio ingress</div>
      </div>
      <div class="arch-node node-gateway">
        <div class="node-badge">Gateway</div>
        <div class="node-title">inbox-gw</div>
        <div class="node-sub">300 req/min quota &bull; Calendar sync ingress</div>
      </div>
      <div class="arch-node node-gateway">
        <div class="node-badge">Gateway</div>
        <div class="node-title">notifications-gw</div>
        <div class="node-sub">300 req/min quota &bull; User alerts ingress</div>
      </div>
    </div>
  </div>

  <!-- Connector -->
  <div class="arch-connector" aria-hidden="true">
    <svg width="24" height="28" viewBox="0 0 24 28" fill="none">
      <path d="M12 2v20m0 0-5-5m5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="connector-pill">Fail-Closed Defense &bull; <code>unhurried-common</code> Go Middleware (ID Re-Verification, App Check, Email Allowlist)</span>
  </div>

  <!-- Tier 3: Compute (5 Go Cloud Run Services) -->
  <div class="arch-tier">
    <div class="tier-label">
      <span class="tier-num">03</span>
      <span>Compute Tier &bull; Go 1.27 on Cloud Run (Distroless Non-Root, Scale-to-Zero)</span>
    </div>
    <div class="tier-grid services-grid">
      <div class="arch-node node-service">
        <div class="node-badge">Go Service</div>
        <div class="node-title">job-search</div>
        <div class="node-sub">Direction &amp; written criteria &bull; Grounded research via Gemini 3.5 Flash &bull; Greenhouse, Lever, Ashby, Adzuna discovery</div>
      </div>
      <div class="arch-node node-service">
        <div class="node-badge">Go Service</div>
        <div class="node-title">applications</div>
        <div class="node-sub">Stage gates (&ge;30 char rationale) &bull; Strict &le;5 active shortlist ceiling &bull; Outreach Kits &bull; Conversations &amp; rounds</div>
      </div>
      <div class="arch-node node-service">
        <div class="node-badge">Go Service</div>
        <div class="node-title">resume</div>
        <div class="node-sub">Google Docs Workspace (<code>drive.file</code> scope) &bull; Gemini 3.5 Flash tailored resume copy &bull; Cloud KMS token sealing</div>
      </div>
      <div class="arch-node node-service">
        <div class="node-badge">Go Service</div>
        <div class="node-title">inbox</div>
        <div class="node-sub">Google Calendar API (<code>calendar.events.readonly</code>) &bull; KMS decryption &bull; Live interview heuristics (events never stored in Firestore)</div>
      </div>
      <div class="arch-node node-service">
        <div class="node-badge">Go Service</div>
        <div class="node-title">notifications</div>
        <div class="node-sub">Scheduled 07:00 Central scan alerts &bull; Daily job discovery email digests via Resend SMTP relay</div>
      </div>
    </div>
  </div>

  <!-- Connector -->
  <div class="arch-connector" aria-hidden="true">
    <svg width="24" height="28" viewBox="0 0 24 28" fill="none">
      <path d="M12 2v20m0 0-5-5m5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="connector-pill">Internal Service Mesh &bull; Google-Signed OIDC Bearer Tokens on <code>/internal/*</code> + Least-Privilege IAM</span>
  </div>

  <!-- Tier 4: Managed Data, AI & Supply Chain -->
  <div class="arch-tier">
    <div class="tier-label">
      <span class="tier-num">04</span>
      <span>Platform, Data &amp; Security Tier &bull; Serverless &amp; Cryptographically Enforced</span>
    </div>
    <div class="tier-grid four-col">
      <div class="arch-node node-data">
        <div class="node-title">Cloud Firestore</div>
        <div class="node-sub">Native Mode NoSQL document persistence (<code>us-central1</code>) &bull; Strict caller user-ID scoping (404 on cross-user reads)</div>
      </div>
      <div class="arch-node node-data">
        <div class="node-title">Cloud KMS &amp; Secret Mgr</div>
        <div class="node-sub">Key Ring: <code>unhurried</code> for envelope encryption of OAuth refresh tokens &bull; Secret Manager for OAuth &amp; SMTP secrets</div>
      </div>
      <div class="arch-node node-data">
        <div class="node-title">Vertex AI (Gemini 3.5 Flash)</div>
        <div class="node-sub">Grounded research summaries with Google Search citations &bull; Contextual, structured resume tailoring</div>
      </div>
      <div class="arch-node node-data">
        <div class="node-title">CI/CD &amp; Provenance</div>
        <div class="node-sub">Work flows <code>dev &rarr; staging &rarr; main</code> &bull; GitHub Actions CI (zero GCP secrets) &bull; Cloud Build + Cloud Deploy (SLSA verified)</div>
      </div>
    </div>
  </div>
</figure>

<style>
  .arch-diagram {
    margin: 1.75rem 0 2.25rem;
    padding: 1.4rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .arch-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px dashed var(--border-strong);
  }

  .arch-kicker {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .arch-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .arch-tier {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem 1.1rem;
  }

  .tier-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }

  .tier-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.1rem 0.45rem;
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-border);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
  }

  .tier-grid {
    display: grid;
    gap: 0.75rem;
  }

  .two-col {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .three-col {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .four-col {
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  }

  .five-col {
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .services-grid {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .arch-node {
    padding: 0.85rem 0.95rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color 0.18s, transform 0.18s;
  }

  .arch-node:hover {
    border-color: var(--accent-border);
    transform: translateY(-1px);
  }

  .node-client {
    border-left: 3px solid var(--accent);
  }

  .node-gateway {
    border-top: 3px solid var(--accent);
    text-align: center;
  }

  .node-service {
    border-top: 3px solid var(--emerald);
  }

  .node-data {
    border-left: 3px solid var(--emerald);
  }

  .node-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--emerald);
    margin-bottom: 0.25rem;
  }

  .node-title {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    margin-bottom: 0.25rem;
  }

  .node-sub {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .arch-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    margin: 0.45rem 0;
    color: var(--accent);
  }

  .connector-pill {
    font-size: 0.72rem;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.18rem 0.75rem;
    text-align: center;
    max-width: 95%;
  }

  .connector-pill code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .arch-diagram {
      padding: 1rem;
    }
  }
</style>
