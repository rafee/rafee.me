---
interface Props {
  title: string;
  img?: string;
  desc: string;
  url: string;
  badge?: string;
  tags?: string[];
  target?: string;
  pubDate?: Date;
  readingTime?: number;
}

const { title, img, desc, url, badge, tags, target = "_self", pubDate, readingTime } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<div class="rounded-xl bg-base-100 hover:shadow-xl transition-all duration-200 hover:scale-[101.5%] border border-base-300/70 hover:border-primary/40 group overflow-hidden">
  <a href={url} target={target} class="block p-5 sm:p-6">
    <div class="flex flex-col sm:flex-row gap-5">
      {img && (
        <div class="sm:w-48 h-32 w-full shrink-0 overflow-hidden rounded-lg bg-base-200 border border-base-300/50">
          <img src={img} alt={title} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
        </div>
      )}
      <div class="grow flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <h2 class="text-xl font-bold group-hover:text-primary transition-colors">
              {title}
            </h2>
            {badge && <span class="badge badge-secondary badge-sm font-semibold">{badge}</span>}
          </div>
          
          {(pubDate || readingTime) && (
            <div class="flex items-center gap-2 text-xs opacity-60 mb-2 font-mono">
              {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
              {pubDate && readingTime && <span>•</span>}
              {readingTime && <span>{readingTime} min read</span>}
            </div>
          )}

          <p class="text-sm opacity-80 leading-relaxed line-clamp-3">
            {desc}
          </p>
        </div>

        {tags && tags.length > 0 && (
          <div class="card-actions justify-end mt-4 gap-1.5">
            {tags.slice(0, 5).map((tag) => (
              <span class="badge badge-outline badge-sm hover:badge-primary transition-colors text-xs">
                {tag}
              </span>
            ))}
            {tags.length > 5 && (
              <span class="badge badge-ghost badge-sm opacity-60 text-xs">+{tags.length - 5}</span>
            )}
          </div>
        )}
      </div>
    </div>
  </a>
</div>
