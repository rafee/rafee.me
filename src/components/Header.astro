---
import { SITE } from '../consts';

const pathname = Astro.url.pathname;

const navItems = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/posts/', label: 'Blog' },
  { href: '/archives/', label: 'Archive' },
  { href: '/search/', label: 'Search' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname === href.replace(/\/$/, '') || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <span class="brand-dot" aria-hidden="true"></span>
      <span>{SITE.title}</span>
    </a>

    <nav class="nav-group" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}

      <button
        id="theme-toggle"
        type="button"
        class="theme-btn"
        aria-label="Toggle light and dark theme"
        title="Toggle light / dark theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>
    </nav>
  </div>
</header>
