---
import { SITE } from '../consts';

interface Props {
  title?: string;
}

const { title = SITE.title } = Astro.props;
---

<header class="sticky top-0 z-30 flex h-16 w-full justify-center bg-opacity-90 backdrop-blur transition-all duration-100 bg-base-100 text-base-content border-b border-base-200">
  <div class="navbar w-full max-w-[960px] px-4">
    <!-- Mobile hamburger button -->
    <div class="navbar-start">
      <label for="my-drawer" class="btn btn-square btn-ghost lg:hidden" aria-label="Open navigation menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
      <a href="/" class="btn btn-ghost normal-case text-lg font-bold font-mono tracking-tight lg:hidden">
        {SITE.shortName}<span class="text-primary">.me</span>
      </a>
    </div>

    <!-- Center brand / tagline for desktop -->
    <div class="navbar-center hidden lg:flex">
      <span class="text-xs uppercase font-mono tracking-wider opacity-60">
        {SITE.tagline}
      </span>
    </div>

    <!-- Right controls: Search & Theme Switcher -->
    <div class="navbar-end gap-1">
      <a href="/search/" class="btn btn-ghost btn-circle btn-sm" aria-label="Search site" title="Search">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Theme Switcher Button -->
      <button class="theme-toggle-btn btn btn-ghost btn-circle btn-sm" aria-label="Toggle Theme (Cupcake / Dark)" title="Toggle Theme">
        <span class="theme-icon-cupcake hidden text-base">🧁</span>
        <span class="theme-icon-dark hidden text-base">🌙</span>
      </button>
    </div>
  </div>
</header>
