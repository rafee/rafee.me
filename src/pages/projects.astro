---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalCard from '../components/HorizontalCard.astro';
import UnhurriedArchitecture from '../components/UnhurriedArchitecture.astro';
---

<BaseLayout
  title="Projects & Systems"
  description="Curated technical projects, cloud architecture blueprints, forensics investigations, and engineering research by Ishfaque Jahan Rafee."
  sideBarActiveItemID="projects"
>
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Projects &amp; Systems</h1>
    <p class="text-base sm:text-lg opacity-80 leading-relaxed max-w-2xl">
      A curated overview of active systems engineering projects, cloud security blueprints, enterprise Zero-Trust architectures, and open-source contributions.
    </p>
  </div>

  <!-- Flagship Section: Unhurried -->
  <section id="unhurried" class="mb-12">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
      <div>
        <span class="badge badge-primary badge-outline text-xs uppercase font-mono tracking-wider mb-1">
          Flagship Systems Project
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
          Unhurried — The Intentional Career Platform
        </h2>
      </div>
      <a
        href="https://github.com/Unhurried-Careers"
        target="_blank"
        rel="noopener noreferrer"
        class="badge badge-primary gap-1 py-3 px-3 hover:scale-105 transition-transform"
      >
        <span>GitHub Organization</span>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M14 3h7v7h-2V6.414l-9.293 9.293-1.414-1.414L17.586 5H14V3zM5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/></svg>
      </a>
    </div>

    <div class="card bg-base-100 border border-base-200 p-6 rounded-xl shadow-sm mb-6">
      <div class="prose max-w-none text-base">
        <p>
          AI auto-apply bots have flooded recruitment pipelines, creating noise for hiring teams and fatigue for job seekers. <strong>Unhurried</strong> takes the opposite approach: leveraging AI not as a spam cannon, but as a <strong>personal researcher</strong> that enables candidates to pursue a small, curated set of opportunities with genuine intent and tailored fit.
        </p>

        <h3 class="text-xl font-bold mt-4 mb-2">Core Design Principles</h3>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>Company Watchlists</strong>: Track specific companies with documented rationale before roles are broadly published, actively reading Greenhouse, Lever, and Ashby job boards.</li>
          <li><strong>Strict Shortlist Limit</strong>: Candidates are hard-capped at a maximum of <strong>5 active roles</strong> at any time. Moving a role to the shortlist requires written answers for <em>"Why this company?"</em> and <em>"Why this role?"</em>.</li>
          <li><strong>Intentional Outreach Kit</strong>: Generates personalized 300-character notes aimed at curious, peer-to-peer conversations rather than transactional referral requests.</li>
          <li><strong>Resume Studio</strong>: Deeply tailors a Google Doc resume to one shortlisted role based on selected skill focus areas.</li>
        </ul>
      </div>
    </div>

    <!-- Live Architecture Diagram -->
    <div class="mb-8">
      <UnhurriedArchitecture />
    </div>

    <!-- Repository Breakdown Cards -->
    <h3 class="text-xl font-bold mb-4">Architecture Microservices Breakdown</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="card bg-base-100 border border-base-200 p-5 rounded-xl shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-primary">unhurried-web</span>
          <span class="badge badge-ghost badge-sm font-mono">React / TS</span>
        </div>
        <p class="text-sm opacity-80 mb-3">
          Responsive dashboard frontend hosted on Firebase Global CDN. Implements shortlist management, company research views, and prompt-driven outreach.
        </p>
        <div class="text-xs font-mono opacity-60">Firebase Hosting · Vite · Tailwind</div>
      </div>

      <div class="card bg-base-100 border border-base-200 p-5 rounded-xl shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-primary">unhurried-core</span>
          <span class="badge badge-ghost badge-sm font-mono">Go / Cloud Run</span>
        </div>
        <p class="text-sm opacity-80 mb-3">
          Central business logic API enforcing the 5-role shortlist ceiling, resume tailoring, and profile telemetry.
        </p>
        <div class="text-xs font-mono opacity-60">Google Cloud Run · Firestore · OIDC</div>
      </div>

      <div class="card bg-base-100 border border-base-200 p-5 rounded-xl shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-primary">board-sync</span>
          <span class="badge badge-ghost badge-sm font-mono">Python / Async</span>
        </div>
        <p class="text-sm opacity-80 mb-3">
          Scheduled ingestion service querying ATS APIs (Greenhouse, Lever, Ashby, Workday) with differential state caching.
        </p>
        <div class="text-xs font-mono opacity-60">Cloud Scheduler · Pub/Sub · Firestore</div>
      </div>

      <div class="card bg-base-100 border border-base-200 p-5 rounded-xl shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono font-bold text-primary">infra</span>
          <span class="badge badge-ghost badge-sm font-mono">Terraform IaC</span>
        </div>
        <p class="text-sm opacity-80 mb-3">
          Complete declarative infrastructure definitions for GCP resources, IAM least privilege bindings, and CI/CD triggers.
        </p>
        <div class="text-xs font-mono opacity-60">Terraform · GCP · Artifact Registry</div>
      </div>
    </div>
  </section>

  <div class="divider my-8"></div>

  <!-- Enterprise Security & Cloud Defense Systems -->
  <section class="mb-8">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-6">
      Enterprise Security Architecture &amp; Engineering Systems
    </h2>

    <div class="flex flex-col gap-4">
      <HorizontalCard
        title="Zero-Trust Network Access & SASE Architecture"
        desc="Designed and implemented enterprise-wide SASE and ZTNA using Cloudflare One, paired with Microsoft Entra ID conditional access and phishing-resistant FIDO2 MFA for identity-centric perimeters."
        url="/about/"
        badge="ZERO TRUST"
        tags={["Cloudflare One", "ZTNA", "Entra ID", "SASE", "MFA"]}
      />

      <HorizontalCard
        title="Competitive Platform Proof-of-Value (PoV) Program"
        desc="Technical validation assessments benchmarking Palo Alto Networks, SentinelOne, and CrowdStrike across enterprise workloads, driving $200K CAD in annual savings and 45% budget efficiency."
        url="/about/"
        badge="PoV / ARCHITECTURE"
        tags={["CrowdStrike", "SentinelOne", "Palo Alto", "EDR", "SIEM"]}
      />

      <HorizontalCard
        title="Dynamic Application Security Testing (DAST) Program"
        desc="Evaluated 7 DAST platforms and deployed Escape DAST with Jira automated remediation pipelines, transitioning to risk-based traffic scoring and eliminating 100% of WAF exceptions."
        url="/about/"
        badge="APPSEC"
        tags={["DAST", "Escape", "AppSec", "WAF", "API Security"]}
      />

      <HorizontalCard
        title="DFIR Memory Forensics Automation Pipeline"
        desc="Reproducible incident response workflows built on top of Volatility 3 and custom python parsers for identifying process injection, unlinked DLLs, and rogue C2 beacons in memory dumps."
        url="/posts/htb_recollection/"
        badge="FORENSICS"
        tags={["DFIR", "Volatility3", "Memory Forensics", "Incident Response"]}
      />

      <HorizontalCard
        title="Multi-Cloud Governance & Automated Change Management"
        desc="Multi-cloud guardrails across AWS, Azure, and OCI leveraging AWS Control Tower for SOC2 and ISO 27001/42001 compliance, plus custom Python API automations cutting operational overhead by 70%."
        url="/posts/iac/"
        badge="AUTOMATION"
        tags={["AWS Control Tower", "Python", "SOC2", "ISO 27001", "IaC"]}
      />
    </div>
  </section>
</BaseLayout>
