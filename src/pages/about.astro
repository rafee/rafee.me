---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout
  title="About & CV"
  description="Background, career journey, security competencies, and academic research of Mohammad Ishfaque Jahan Rafee."
  sideBarActiveItemID="about"
>
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">About &amp; CV</h1>
    <p class="text-base sm:text-lg opacity-80 leading-relaxed max-w-2xl">
      Hi, I'm <strong>{SITE.title}</strong> — a <strong>{SITE.role}</strong> based in {SITE.location}. Online, I write and build as <a href={SITE.socials.twitter} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{SITE.socials.twitterHandle}</a>.
    </p>
  </div>

  <div class="prose lg:prose-lg max-w-none text-base-content">
    <p>
      I specialize in <strong>Cloud Security Architecture (AWS &amp; OCI)</strong>, <strong>Infrastructure Defense</strong>, <strong>Digital Forensics &amp; Incident Response (DFIR)</strong>, and <strong>Security Automation</strong>. My engineering philosophy centers on building pragmatic, robust defenses that empower development and operations rather than slowing them down.
    </p>

    <div class="divider my-6"></div>

    <h2 class="text-2xl font-bold mb-4">Professional Experience</h2>

    <div class="space-y-6 not-prose my-6">
      <!-- CMiC -->
      <div class="card bg-base-100 border border-base-200 p-6 rounded-xl shadow-sm">
        <div class="flex items-start justify-between flex-wrap gap-2 mb-2">
          <div>
            <h3 class="text-lg font-bold">Security Engineer</h3>
            <p class="text-sm font-semibold text-primary">CMiC &bull; Cloud ERP Security</p>
          </div>
          <span class="badge badge-outline text-xs font-mono">Present</span>
        </div>
        <p class="text-sm opacity-80 mb-3">
          Safeguarding enterprise ERP cloud environments across <strong>Amazon Web Services (AWS)</strong> and <strong>Oracle Cloud Infrastructure (OCI)</strong>:
        </p>
        <ul class="list-disc pl-5 text-sm opacity-80 space-y-1">
          <li><strong>Cloud Security Architecture</strong>: Designed multi-account isolation, landing zones, transit network segmentation, and IAM least-privilege boundary policies.</li>
          <li><strong>Detection Engineering &amp; Incident Response</strong>: Spearheaded security telemetry pipelines aggregating VPC Flow Logs, CloudTrail, GuardDuty, and audit trails into automated alerting.</li>
          <li><strong>DevSecOps &amp; Infrastructure as Code</strong>: Embedded security guardrails into Terraform IaC pipelines, enforcing drift detection and pre-deployment policy checks.</li>
        </ul>
      </div>

      <!-- ZTE -->
      <div class="card bg-base-100 border border-base-200 p-6 rounded-xl shadow-sm">
        <div class="flex items-start justify-between flex-wrap gap-2 mb-2">
          <div>
            <h3 class="text-lg font-bold">Technical Account Manager / Pre-Sales</h3>
            <p class="text-sm font-semibold text-primary">ZTE Corporation</p>
          </div>
          <span class="badge badge-outline text-xs font-mono">2017 – 2019</span>
        </div>
        <p class="text-sm opacity-80 mb-3">
          Led technical consulting and account management for high-stakes telecommunications and government infrastructure projects, including a multi-vendor project valued near <strong>USD $200M</strong>.
        </p>
        <ul class="list-disc pl-5 text-sm opacity-80 space-y-1">
          <li>Coordinated multi-stakeholder security governance and compliance reviews.</li>
          <li>Bridged engineering teams and C-suite leadership on mission-critical system migrations.</li>
        </ul>
      </div>

      <!-- Huawei -->
      <div class="card bg-base-100 border border-base-200 p-6 rounded-xl shadow-sm">
        <div class="flex items-start justify-between flex-wrap gap-2 mb-2">
          <div>
            <h3 class="text-lg font-bold">Solutions Engineer</h3>
            <p class="text-sm font-semibold text-primary">Huawei Technologies</p>
          </div>
          <span class="badge badge-outline text-xs font-mono">2015 – 2017</span>
        </div>
        <p class="text-sm opacity-80 mb-3">
          Communicated across the entire organizational spectrum, collaborating with seasoned technical teams on granular technical details while articulating business impact, ROI, and risk posture to CXO executives.
        </p>
      </div>
    </div>

    <div class="divider my-6"></div>

    <h2 class="text-2xl font-bold mb-4">Education</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-6">
      <div class="card bg-base-100 border border-base-200 p-5 rounded-xl shadow-sm">
        <span class="badge badge-primary badge-sm font-mono mb-2">Graduate Degree</span>
        <h3 class="text-base font-bold">Master of Engineering (MEng)</h3>
        <p class="text-sm text-primary font-medium">Information Systems Security</p>
        <p class="text-xs opacity-75 mt-1">Concordia University &bull; Montreal, Canada</p>
        <p class="text-xs opacity-60 mt-2">Specialization: Network Security, Cryptography, Distributed Systems, Software Verification.</p>
      </div>

      <div class="card bg-base-100 border border-base-200 p-5 rounded-xl shadow-sm">
        <span class="badge badge-secondary badge-sm font-mono mb-2">Undergraduate</span>
        <h3 class="text-base font-bold">Bachelor of Science (BSc)</h3>
        <p class="text-sm text-primary font-medium">Electrical &amp; Electronic Engineering</p>
        <p class="text-xs opacity-75 mt-1">Bangladesh University of Engineering and Technology (BUET)</p>
        <p class="text-xs opacity-60 mt-2">Rigorous foundational engineering, signal processing, mathematics, and embedded systems.</p>
      </div>
    </div>

    <div class="divider my-6"></div>

    <h2 class="text-2xl font-bold mb-4">Core Competencies</h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 not-prose my-6">
      <div class="card bg-base-100 border border-base-200 p-4 rounded-xl">
        <h4 class="font-bold text-sm mb-2 text-primary font-mono">Cloud Security &amp; Defense</h4>
        <div class="flex flex-wrap gap-1">
          <span class="badge badge-sm badge-ghost">AWS</span>
          <span class="badge badge-sm badge-ghost">OCI</span>
          <span class="badge badge-sm badge-ghost">IAM / Least-Privilege</span>
          <span class="badge badge-sm badge-ghost">CloudTrail / GuardDuty</span>
          <span class="badge badge-sm badge-ghost">KMS</span>
          <span class="badge badge-sm badge-ghost">Zero Trust</span>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-200 p-4 rounded-xl">
        <h4 class="font-bold text-sm mb-2 text-primary font-mono">DFIR &amp; SecOps</h4>
        <div class="flex flex-wrap gap-1">
          <span class="badge badge-sm badge-ghost">Volatility 2 &amp; 3</span>
          <span class="badge badge-sm badge-ghost">Memory Forensics</span>
          <span class="badge badge-sm badge-ghost">Malware Triage</span>
          <span class="badge badge-sm badge-ghost">Incident Response</span>
          <span class="badge badge-sm badge-ghost">Linux Auditing</span>
          <span class="badge badge-sm badge-ghost">SIEM</span>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-200 p-4 rounded-xl">
        <h4 class="font-bold text-sm mb-2 text-primary font-mono">DevSecOps &amp; Code</h4>
        <div class="flex flex-wrap gap-1">
          <span class="badge badge-sm badge-ghost">Python</span>
          <span class="badge badge-sm badge-ghost">Go</span>
          <span class="badge badge-sm badge-ghost">Terraform (IaC)</span>
          <span class="badge badge-sm badge-ghost">CI/CD Security</span>
          <span class="badge badge-sm badge-ghost">Docker</span>
          <span class="badge badge-sm badge-ghost">Bash</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
