---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPostSlug, getReadingStats, slugifyTag } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { minutes, words } = getReadingStats(post.body);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description || post.data.title}
  article={true}
  sideBarActiveItemID="posts"
>
  <article class="max-w-none">
    <!-- Back Navigation -->
    <div class="mb-6">
      <a href="/posts/" class="btn btn-ghost btn-sm gap-2 font-mono text-xs opacity-75 hover:opacity-100">
        &larr; Back to all writeups
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-8 pb-6 border-b border-base-200">
      <div class="flex items-center gap-2 text-xs font-mono opacity-60 mb-2">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>•</span>
        <span>{minutes} min read ({words.toLocaleString()} words)</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-base-content">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="text-lg opacity-85 leading-relaxed mb-4 italic">
          {post.data.description}
        </p>
      )}

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${slugifyTag(tag)}/`} class="badge badge-outline badge-sm hover:badge-primary transition-colors text-xs">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Markdown / MDX Content rendered in DaisyUI / Tailwind Prose -->
    <div class="prose lg:prose-lg max-w-none">
      <Content />
    </div>

    <!-- Bottom Navigation Footer -->
    <div class="divider my-8"></div>

    <div class="flex justify-between items-center flex-wrap gap-4 py-4">
      <a href="/posts/" class="btn btn-outline btn-sm">
        &larr; All Articles
      </a>
      <a href="/about/" class="btn btn-ghost btn-sm">
        About the Author &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
