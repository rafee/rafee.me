---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalCard from '../../components/HorizontalCard.astro';
import { getPublishedPosts, getPostSlug, getReadingStats, slugifyTag } from '../../utils/posts';

const posts = await getPublishedPosts();

// Collect all unique tags with count
const tagCounts = new Map<string, number>();
posts.forEach((p) => {
  p.data.tags.forEach((t) => {
    tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="Technical Blog"
  description="Security writeups, DFIR walkthroughs, cloud defense notes, and automation experiments by Mohammad Ishfaque Jahan Rafee."
  sideBarActiveItemID="posts"
>
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Technical Blog &amp; Writeups</h1>
    <p class="text-base sm:text-lg opacity-80 leading-relaxed max-w-2xl">
      Deep-dive investigations into memory forensics, incident response, zero-day threat analysis, cloud defense, and programming automation.
    </p>
  </div>

  <!-- Tag Filter Chips -->
  {sortedTags.length > 0 && (
    <div class="mb-8 p-4 bg-base-200/60 rounded-xl border border-base-300/60">
      <div class="text-xs font-mono uppercase tracking-wider opacity-70 mb-2 font-semibold">
        Filter by Topic:
      </div>
      <div class="flex flex-wrap gap-1.5">
        {sortedTags.map(([tag, count]) => (
          <a
            href={`/tags/${slugifyTag(tag)}/`}
            class="badge badge-outline hover:badge-primary transition-colors text-xs py-2.5 px-3"
          >
            #{tag} <span class="opacity-60 ml-1">({count})</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Post List with Astrofy Horizontal Cards -->
  <div class="flex flex-col gap-4">
    {posts.map((post) => {
      const stats = getReadingStats(post.body || '');
      return (
        <HorizontalCard
          title={post.data.title}
          desc={post.data.description || ''}
          url={`/posts/${getPostSlug(post)}/`}
          pubDate={post.data.date}
          readingTime={stats.minutes}
          tags={post.data.tags}
        />
      );
    })}
  </div>
</BaseLayout>
