---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalCard from '../../components/HorizontalCard.astro';
import { getPublishedPosts, getPostSlug, getReadingStats, slugifyTag } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const allTags = new Set<string>();

  posts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      allTags.add(tag);
    });
  });

  return Array.from(allTags).map((tag) => {
    const slug = slugifyTag(tag);
    const filteredPosts = posts.filter((p) =>
      p.data.tags.some((t) => slugifyTag(t) === slug)
    );

    return {
      params: { tag: slug },
      props: { tag, posts: filteredPosts },
    };
  });
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`Tag: #${tag}`}
  description={`All articles and writeups tagged with #${tag}`}
  sideBarActiveItemID="tags"
>
  <div class="mb-8">
    <div class="mb-4">
      <a href="/tags/" class="btn btn-ghost btn-sm gap-2 font-mono text-xs opacity-75 hover:opacity-100">
        &larr; Back to all tags
      </a>
    </div>

    <div class="flex items-center gap-3">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">#{tag}</h1>
      <span class="badge badge-primary badge-lg font-mono">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'}
      </span>
    </div>
  </div>

  <div class="flex flex-col gap-4">
    {posts.map((post) => {
      const stats = getReadingStats(post.body || '');
      return (
        <HorizontalCard
          title={post.data.title}
          desc={post.data.description || ''}
          url={`/posts/${getPostSlug(post)}/`}
          pubDate={post.data.date}
          readingTime={stats.minutes}
          tags={post.data.tags}
        />
      );
    })}
  </div>
</BaseLayout>
