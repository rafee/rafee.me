---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, slugifyTag } from '../../utils/posts';

const posts = await getPublishedPosts();

const tagMap = new Map<string, { label: string; count: number }>();
posts.forEach((p) => {
  p.data.tags.forEach((t) => {
    const slug = slugifyTag(t);
    const existing = tagMap.get(slug);
    if (existing) {
      existing.count += 1;
    } else {
      tagMap.set(slug, { label: t, count: 1 });
    }
  });
});

const allTags = Array.from(tagMap.entries()).sort((a, b) => b[1].count - a[1].count);
---

<BaseLayout
  title="All Tags"
  description="Browse articles, security writeups, and projects by category and tag."
  sideBarActiveItemID="tags"
>
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Tags &amp; Topics</h1>
    <p class="text-base sm:text-lg opacity-80 leading-relaxed max-w-2xl">
      Browse all technical articles and writeups by category.
    </p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
    {allTags.map(([slug, { label, count }]) => (
      <a
        href={`/tags/${slug}/`}
        class="card bg-base-100 border border-base-200 p-4 rounded-xl hover:border-primary/50 hover:shadow-md transition-all hover:scale-[102%] group"
      >
        <span class="font-bold text-sm group-hover:text-primary transition-colors block truncate">
          #{label}
        </span>
        <span class="text-xs opacity-60 font-mono mt-1 block">
          {count} {count === 1 ? 'article' : 'articles'}
        </span>
      </a>
    ))}
  </div>
</BaseLayout>
