---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalCard from '../components/HorizontalCard.astro';
import UnhurriedArchitecture from '../components/UnhurriedArchitecture.astro';
import { getPublishedPosts, getPostSlug, getReadingStats } from '../utils/posts';
import { SITE } from '../consts';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 4);
---

<BaseLayout sideBarActiveItemID="home">
  <!-- Hero Section -->
  <div class="pb-10 pt-2">
    <div class="flex items-center gap-2 flex-wrap mb-2">
      <span class="text-xl opacity-80">Hey there 👋</span>
      <span class="badge badge-primary badge-outline text-xs font-mono font-bold">CISSP &bull; AWS Solutions Architect Pro</span>
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-1 text-base-content">
      {SITE.title}
    </h1>
    <h2 class="text-2xl sm:text-3xl py-2 font-bold text-primary">
      {SITE.role} &amp; Enterprise Security Architect
    </h2>

    <div class="py-2">
      <p class="text-base sm:text-lg opacity-85 leading-relaxed max-w-2xl">
        With <strong>9+ years of experience</strong> across enterprise cloud security architecture (<strong>AWS, Azure, OCI</strong>), SecOps &amp; DFIR, and technical pre-sales. Employee #4 at CMiC security team, #2 at Huawei Cloud Solutions team. Currently engineering <strong>Unhurried</strong> — an intentional, privacy-first career platform.
      </p>
    </div>
    
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a class="btn btn-primary" href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer">
        Let's Connect
      </a>
      <a class="btn btn-outline" href="/about/">
        View Full CV &rarr;
      </a>
      <a class="btn btn-outline" href="/projects/">
        Projects &amp; Systems
      </a>
      <a class="btn btn-ghost" href="/posts/">
        Read Blog
      </a>
    </div>
  </div>

  <div class="divider my-4"></div>

  <!-- Featured Project Spotlight: Unhurried -->
  <div class="my-6">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
        Featured Project: Unhurried {"</>"}
      </h2>
      <div class="flex items-center gap-2">
        <a
          href="https://unhurried-careers.com"
          target="_blank"
          rel="noopener noreferrer"
          class="badge badge-ghost gap-1 py-3 px-3 hover:scale-105 transition-transform font-mono"
        >
          <span>Live App</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M14 3h7v7h-2V6.414l-9.293 9.293-1.414-1.414L17.586 5H14V3zM5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/></svg>
        </a>
        <a
          href="https://github.com/Unhurried-Careers"
          target="_blank"
          rel="noopener noreferrer"
          class="badge badge-primary gap-1 py-3 px-3 hover:scale-105 transition-transform font-mono"
        >
          <span>GitHub Org</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M14 3h7v7h-2V6.414l-9.293 9.293-1.414-1.414L17.586 5H14V3zM5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/></svg>
        </a>
      </div>
    </div>

    <HorizontalCard
      title="Unhurried: Intentional Career Navigation Platform"
      img="/images/nuxt_amplify.png"
      desc="A deliberate, privacy-first career platform built on Google Cloud serverless architecture (5 Go microservices on Cloud Run, 5 API Gateways, React 18 SPA on Firebase Hosting). Replaces AI auto-apply spam with grounded Gemini 3.5 Flash research, strict ≤5 active shortlist gates, envelope-encrypted Google Docs/Calendar integrations, and a non-submitting Chrome MV3 assistant."
      url="/projects/#unhurried"
      badge="FLAGSHIP"
      tags={["Google Cloud", "Go 1.27", "Cloud Run", "React 18", "Terraform", "Vertex AI", "KMS"]}
    />

    <div class="mt-6">
      <UnhurriedArchitecture />
    </div>
  </div>

  <div class="divider my-8"></div>

  <!-- Latest Blog Posts -->
  <div class="my-6">
    <div class="flex justify-between items-center mb-5">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
        Latest Technical Writeups
      </h2>
      <a href="/posts/" class="text-sm font-semibold text-primary hover:underline">
        View All ({posts.length}) &rarr;
      </a>
    </div>

    <div class="flex flex-col gap-4">
      {latestPosts.map((post) => {
        const stats = getReadingStats(post.body || '');
        return (
          <HorizontalCard
            title={post.data.title}
            desc={post.data.description || ''}
            url={`/posts/${getPostSlug(post)}/`}
            pubDate={post.data.date}
            readingTime={stats.minutes}
            tags={post.data.tags}
          />
        );
      })}
    </div>
  </div>
</BaseLayout>
