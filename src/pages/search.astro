---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPostSlug, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();

const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  date: formatDate(post.data.date),
  slug: getPostSlug(post),
  tags: post.data.tags,
}));
---

<BaseLayout
  title="Search"
  description="Instant full-text search across all blog posts, DFIR writeups, and security articles."
  sideBarActiveItemID="search"
>
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Search</h1>
    <p class="text-base sm:text-lg opacity-80 leading-relaxed max-w-2xl">
      Instant search across all technical articles, memory forensics walkthroughs, and tags.
    </p>
  </div>

  <div class="mb-8">
    <div class="form-control w-full">
      <div class="relative">
        <input
          id="search-input"
          type="search"
          placeholder="Search articles, tags, tools (e.g. 'volatility', 'aws', 'iac', 'zero-day')..."
          class="input input-bordered w-full pl-12 pr-4 h-14 text-base rounded-xl shadow-sm focus:input-primary"
          autocomplete="off"
          autofocus
        />
        <svg
          class="absolute left-4 top-4.5 h-5 w-5 opacity-50"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
    <div id="search-status" class="text-xs font-mono opacity-60 mt-2 px-1">
      Showing all {posts.length} articles
    </div>
  </div>

  <div id="search-results" class="flex flex-col gap-4"></div>

  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />

  <script>
    interface SearchItem {
      title: string;
      description: string;
      date: string;
      slug: string;
      tags: string[];
    }

    const dataEl = document.getElementById('search-data');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results');
    const statusEl = document.getElementById('search-status');

    if (dataEl && input && resultsContainer && statusEl) {
      const items: SearchItem[] = JSON.parse(dataEl.textContent || '[]');

      function renderResults(query: string) {
        const q = query.trim().toLowerCase();
        const filtered = items.filter((item) => {
          if (!q) return true;
          return (
            item.title.toLowerCase().includes(q) ||
            item.description.toLowerCase().includes(q) ||
            item.tags.some((t) => t.toLowerCase().includes(q))
          );
        });

        statusEl.textContent = q
          ? `Found ${filtered.length} ${filtered.length === 1 ? 'article' : 'articles'} matching "${query}"`
          : `Showing all ${items.length} articles`;

        if (filtered.length === 0) {
          resultsContainer.innerHTML = `
            <div class="card bg-base-100 border border-base-200 p-8 text-center rounded-xl my-4">
              <p class="text-lg font-bold mb-1">No articles found</p>
              <p class="text-sm opacity-60">Try searching for different keywords or explore <a href="/tags/" class="text-primary underline">all topics</a>.</p>
            </div>
          `;
          return;
        }

        resultsContainer.innerHTML = filtered
          .map((item) => {
            const tagsHtml = item.tags
              .slice(0, 4)
              .map((tag) => `<span class="badge badge-outline badge-sm text-xs">#${tag}</span>`)
              .join(' ');

            return `
              <div class="rounded-xl bg-base-100 hover:shadow-xl transition-all duration-200 hover:scale-[101.5%] border border-base-300/70 hover:border-primary/40 group p-5 sm:p-6">
                <a href="/posts/${item.slug}/" class="block">
                  <div class="flex items-center gap-2 text-xs font-mono opacity-60 mb-1">
                    <span>${item.date}</span>
                  </div>
                  <h2 class="text-xl font-bold group-hover:text-primary transition-colors mb-2">
                    ${item.title}
                  </h2>
                  <p class="text-sm opacity-80 leading-relaxed mb-4 line-clamp-2">
                    ${item.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5 justify-end">
                    ${tagsHtml}
                  </div>
                </a>
              </div>
            `;
          })
          .join('');
      }

      // Initial render
      renderResults('');

      // Input listener
      input.addEventListener('input', (e) => {
        renderResults((e.target as HTMLInputElement).value);
      });
    }
  </script>
</BaseLayout>
