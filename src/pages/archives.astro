---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPostSlug, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();

// Group by year
const postsByYear = new Map<number, typeof posts>();
posts.forEach((post) => {
  const year = post.data.date.getUTCFullYear();
  const list = postsByYear.get(year) || [];
  list.push(post);
  postsByYear.set(year, list);
});

const sortedYears = Array.from(postsByYear.keys()).sort((a, b) => b - a);
---

<BaseLayout
  title="Archives"
  description="Chronological archive of all technical writeups and articles published on rafee.me."
  sideBarActiveItemID="archives"
>
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Chronological Archive</h1>
    <p class="text-base sm:text-lg opacity-80 leading-relaxed max-w-2xl">
      A complete timeline of all {posts.length} published writeups and technical notes.
    </p>
  </div>

  <div class="space-y-8">
    {sortedYears.map((year) => {
      const yearPosts = postsByYear.get(year) || [];
      return (
        <section class="card bg-base-100 border border-base-200 p-6 rounded-xl shadow-sm">
          <div class="flex items-center gap-2 mb-4 pb-2 border-b border-base-200">
            <h2 class="text-2xl font-bold font-mono text-primary">{year}</h2>
            <span class="badge badge-ghost badge-sm font-mono opacity-70">
              {yearPosts.length} {yearPosts.length === 1 ? 'article' : 'articles'}
            </span>
          </div>

          <ul class="space-y-3">
            {yearPosts.map((post) => {
              const slug = getPostSlug(post);
              return (
                <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 justify-between py-1 border-b border-base-200/40 last:border-none">
                  <a
                    href={`/posts/${slug}/`}
                    class="font-semibold text-base hover:text-primary transition-colors flex-1"
                  >
                    {post.data.title}
                  </a>
                  <time
                    datetime={post.data.date.toISOString()}
                    class="text-xs font-mono opacity-60 shrink-0"
                  >
                    {formatDate(post.data.date)}
                  </time>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</BaseLayout>
