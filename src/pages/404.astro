---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found" description="Page not found">
  <div style="text-align: center; padding: 4rem 1rem;">
    <h1 style="font-size: 5rem; margin-bottom: 0.5rem; color: var(--color-primary);">404</h1>
    <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">Page Not Found</h2>
    <p style="color: var(--color-text-muted); max-width: 480px; margin: 0 auto 2rem;">
      The page you are looking for doesn't exist, has been moved, or is temporarily unavailable.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">Return Home</a>
      <a href="/posts/" class="btn btn-outline">Read Blog Posts</a>
      <a href="/search/" class="btn btn-outline">Search Site</a>
    </div>
  </div>
</BaseLayout>
