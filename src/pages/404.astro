---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found" description="Page not found">
  <div class="text-center py-16 px-4">
    <div class="inline-block p-4 rounded-full bg-base-200 mb-4">
      <span class="text-5xl">🧁</span>
    </div>
    <h1 class="text-6xl font-black text-primary mb-2 font-mono">404</h1>
    <h2 class="text-2xl font-bold mb-3">Page Not Found</h2>
    <p class="opacity-75 max-w-md mx-auto mb-8 text-sm sm:text-base leading-relaxed">
      The page you are looking for doesn't exist, has been moved, or is temporarily unavailable.
    </p>
    <div class="flex gap-3 justify-center flex-wrap">
      <a href="/" class="btn btn-primary">Return Home</a>
      <a href="/posts/" class="btn btn-outline">Read Blog</a>
      <a href="/search/" class="btn btn-ghost">Search Site</a>
    </div>
  </div>
</BaseLayout>
